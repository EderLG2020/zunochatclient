{
  "compilerOptions": {
    "target": "es2023",
    // "DOM" hace falta porque los callbacks de page.evaluate() (engine.ts)
    // corren dentro del browser, no en Node — sin esto, tsc no reconoce
    // `document`/`requestAnimationFrame` dentro de esos callbacks.
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["."]
}
